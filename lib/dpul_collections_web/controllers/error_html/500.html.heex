<%!-- Note that we do not render templates through our application layout.
    This is to avoid circular errors. --%>
<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Collections</title>
    <link rel="stylesheet" href="/assets/css/app.css" />
    <style>
      /* This makes the little corners on the message pane. */
      .pane::before, .pane::after {
          content: '';
          position: absolute;
          width: 16px;
          height: 16px;
          border: 1.5px solid var(--color-rust);
      }
      .pane::before { top: 15px; left: 15px; border-right: none; border-bottom: none; }
      .pane::after { bottom: 15px; right: 15px; border-left: none; border-top: none; }
    </style>
  </head>

  <body class="bg-cover bg-center bg-white bg-[url(/images/alexander-pope.jpg)] bg-(--color-background) flex flex-col m-0 min-h-screen antialiased text-dark-text">
    <div class="flex flex-col min-h-screen" id="app">
      {DpulCollectionsWeb.HeaderComponent.header(assigns)}
      {DpulCollectionsWeb.SearchComponents.search_bar(Map.put(assigns, :action, "/search"))}
      <div class="flex-1 flex items-center justify-center p-24">
        <div class="pane max-w-[580px] max-[480px]:px-5 max-[480px]:py-10 w-full bg-sage-50 border border-primary-bright py-[50px] px-[40px] text-center shadow-[0_16px_40px_rgba(0,0,0,0.04)] relative">
          <h1 class="font-[Aleo,serif] font-normal text-(2rem) tracking-(3px) mb-(25px) uppercase color-brand">
            {gettext("Internal Server Error")}
          </h1>

          <div class="my-[25px]">
            <blockquote class="font-['Aleo',serif] text-xl leading-[1.7] text-zinc-800 mb-3 italic max-[480px]:text-[1.15rem]">
              “{gettext("To err is human; to forgive, divine.")}”
            </blockquote>
            <cite class="font-['Poppins',sans] text-xs font-semibold text-rust tracking-[2px] uppercase not-italic block">— Alexander Pope</cite>
          </div>

          <div class="h-px w-20 bg-(--color-cloud) my-[30px] mx-auto"></div>

          <div class="flex justify-center">
            <a href="/" class="btn-primary">{gettext("Return Home")}</a>
          </div>
        </div>
      </div>
      <div class="text-center p-8 bg-white lg:bg-transparent">
        <a
          class="p-4 lg:bg-white lg:opacity-75 leading-10"
          href="/item/d17e0442-14f3-46ee-802d-0a4373b05da6"
        >
          <strong>{gettext("Image Citation")}:</strong>
          {gettext(
            "Alexander Pope Esqr. Selections from the Graphic Arts Collection, Princeton University Library."
          )}
        </a>
      </div>
      {DpulCollectionsWeb.FooterComponent.footer(assigns)}
    </div>
  </body>
</html>
