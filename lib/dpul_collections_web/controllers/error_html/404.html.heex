<%!-- Note that we do not render templates through our application layout.
    This is to avoid circular errors. --%>
<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Collections</title>
    <link rel="stylesheet" href="/assets/css/app.css" />
  </head>

  <body class="bg-cover bg-center bg-white bg-[url(/images/404-hercules-cluster.jpg)] bg-(--color-background) flex flex-col m-0 min-h-screen antialiased text-dark-text">
    <div class="flex flex-col min-h-screen" id="app">
      {DpulCollectionsWeb.HeaderComponent.header(assigns)}
      {DpulCollectionsWeb.SearchComponents.search_bar(Map.put(assigns, :action, "/search"))}
      <div class="flex-1 flex items-center justify-center p-24">
        <div class="max-w-[580px] max-[480px]:px-5 max-[480px]:py-10 w-full bg-sage-50 border border-primary-bright py-[50px] px-[40px] text-center shadow-[0_16px_40px_rgba(0,0,0,0.04)] relative before:absolute before:w-1 before:h-1 before:border before:border-rust after:absolute after:w-1 after:h-1 after:border after:border-rust before:top-(15px) before:left-(15px) before:border-r-0 before:border-b-0 after:bottom-(15px) after:right-(15px) after:border-t-0 after:border-l-0">
          <h1 class="font-[Aleo,serif] font-normal text-(2rem) tracking-(3px) mb-(25px) uppercase color-brand">
            Page Not Found
          </h1>

          <div class="my-[25px]">
            <blockquote class="font-['Aleo',serif] text-xl leading-[1.7] text-zinc-800 mb-3 italic max-[480px]:text-[1.15rem]">
              "If the path before you is clear, you're probably on someone else's path."
            </blockquote>
            <cite class="font-['Poppins',sans] text-xs font-semibold text-rust tracking-[2px] uppercase not-italic block">— Joseph Campbell</cite>
          </div>

          <div class="h-px w-20 bg-(--color-cloud) my-[30px] mx-auto"></div>

          <div class="flex justify-center">
            <a href="/" class="btn-primary">Return Home</a>
          </div>
          <p class="pt-8 italic text-sm text-dark-gray">
            Report broken links to digital-library@princeton.libanswers.com.
          </p>
        </div>
      </div>
      <div class="text-center p-8 bg-white lg:bg-transparent">
        <a
          class="p-4 lg:bg-white lg:opacity-65 leading-10"
          href="/item/81e25521-d109-48f4-bcff-04549296117b"
        >
          <strong>Image Citation:</strong>
          Star cluster in Hercules. Selections from the Graphic Arts Collection, Princeton University Library.
        </a>
      </div>
      {DpulCollectionsWeb.FooterComponent.footer(assigns)}
    </div>
  </body>
</html>
